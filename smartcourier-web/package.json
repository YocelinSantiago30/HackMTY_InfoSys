{
  "name": "smartcourier-web-project",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend start",
    "setup:db": "node scripts/setup-db.cjs",
    "build": "npm --prefix frontend run build",
    "test:web": "npm --prefix frontend test",
    "test:backend": "npm --prefix backend test",
    "verify:copy": "node scripts/verify-copy.mjs",
    "start": "node scripts/local.mjs start",
    "stop": "node scripts/local.mjs stop",
    "status": "node scripts/local.mjs status",
    "test": "npm run test:backend && npm run test:web",
    "evaluate:courier": "node backend/scripts/courier/refineWeb.js holdout",
    "evaluate:comparison": "node backend/scripts/compareStrategies.js"
  }
}
